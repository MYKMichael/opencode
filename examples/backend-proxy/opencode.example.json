{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "my-backend": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "My Backend",
      "options": {
        "baseURL": "http://localhost:3000/v1",
        "apiKey": "dummy-not-needed"
      },
      "models": {
        "model-a": {
          "name": "Model A (Claude Sonnet)",
          "tool_call": true,
          "attachment": true,
          "reasoning": false,
          "temperature": true,
          "structured_output": true,
          "limit": {
            "context": 200000,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "model-b": {
          "name": "Model B (GPT-4o)",
          "tool_call": true,
          "attachment": true,
          "reasoning": false,
          "temperature": true,
          "structured_output": true,
          "limit": {
            "context": 128000,
            "output": 16384
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "model-c": {
          "name": "Model C (DeepSeek-R1)",
          "tool_call": true,
          "attachment": false,
          "reasoning": true,
          "temperature": true,
          "structured_output": true,
          "limit": {
            "context": 64000,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "enabled_providers": ["my-backend"],
  "model": "my-backend/model-a"
}
